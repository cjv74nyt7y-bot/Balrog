      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!strict
-- Keeps each player's Runes and Wins in leaderstats and saves them to a DataStore.
-- In Studio, saving needs "Enable Studio Access to API Services" (Game Settings > Security).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local AUTOSAVE_SECONDS = 120

local DataService = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStores unavailable, progress will not be saved:", result)
	end
end

-- Only players whose data loaded cleanly get saved, so a failed load never wipes progress.
local loaded: { [Player]: boolean } = {}

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function stat(player: Player, name: string): IntValue?
	local leaderstats = player:FindFirstChild("leaderstats")
	return leaderstats and leaderstats:FindFirstChild(name) :: IntValue?
end

local function load(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local runes = Instance.new("IntValue")
	runes.Name = "Runes"
	runes.Parent = leaderstats
	local wins = Instance.new("IntValue")
	wins.Name = "Wins"
	wins.Parent = leaderstats
	leaderstats.Parent = player

	if not store then
		return
	end
	local dataStore = store :: DataStore
	local ok, data = pcall(function()
		return dataStore:GetAsync(keyFor(player))
	end)
	if not ok then
		warn("[DataService] Could not load", player.Name, data)
		return
	end
	if type(data) == "table" then
		runes.Value = tonumber(data.Runes) or 0
		wins.Value = tonumber(data.Wins) or 0
	end
	loaded[player] = true
end

function DataService.save(player: Player)
	local runes, wins = stat(player, "Runes"), stat(player, "Wins")
	if not store or not loaded[player] or not runes or not wins then
		return
	end
	local dataStore = store :: DataStore
	local data = { Runes = (runes :: IntValue).Value, Wins = (wins :: IntValue).Value }
	local ok, err = pcall(function()
		dataStore:SetAsync(keyFor(player), data)
	end)
	if not ok then
		warn("[DataService] Could not save", player.Name, err)
	end
end

function DataService.addRunes(player: Player, amount: number)
	local runes = stat(player, "Runes")
	if runes then
		runes.Value += amount
	end
end

function DataService.addWin(player: Player)
	local wins = stat(player, "Wins")
	if wins then
		wins.Value += 1
	end
end

function DataService.start()
	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		DataService.save(player)
		loaded[player] = nil
	end)

	game:BindToClose(function()
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				DataService.save(player)
				pending -= 1
			end)
		end
		while pending > 0 do
			task.wait()
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for _, player in Players:GetPlayers() do
				task.spawn(DataService.save, player)
			end
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="10">
        <Properties>
          <string name="Name">GameManager</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Runs the round loop: intermission in the lobby, then everyone is dropped into a
-- freshly built shaft and must climb to the escape gate before the lava catches them.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local ShaftBuilder = require(script.Parent.ShaftBuilder)
local World = require(script.Parent.World)

local Remotes = ReplicatedStorage.Remotes
local Notify = Remotes.Notify :: RemoteEvent
local CastWard = Remotes.CastWard :: RemoteEvent
local State = ReplicatedStorage.GameState

local rng = Random.new()
local lobbyCFrame = World.build()
DataService.start()

-- Players still climbing in the current round.
local active: { [Player]: boolean } = {}
local shaft: ShaftBuilder.Shaft? = nil
local lavaTop = Config.LavaStartY

State:SetAttribute("Status", "Starting...")
State:SetAttribute("TimeLeft", 0)
State:SetAttribute("InRound", false)
State:SetAttribute("LavaTop", lavaTop)
State:SetAttribute("GoalY", Config.ShaftOrigin.Y + Config.ShaftHeight)

local function notify(target: Player?, text: string, kind: string)
	if target then
		Notify:FireClient(target, text, kind)
	else
		Notify:FireAllClients(text, kind)
	end
end

local function setStatus(text: string, timeLeft: number)
	State:SetAttribute("Status", text)
	State:SetAttribute("TimeLeft", timeLeft)
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return (character :: Model):FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	return if model then Players:GetPlayerFromCharacter(model) else nil
end

local function leaveRound(player: Player)
	active[player] = nil
	player:SetAttribute("InRound", false)
end

local function sendToLobby(player: Player)
	local character = player.Character
	if character and rootOf(player) then
		character:PivotTo(lobbyCFrame * CFrame.new(rng:NextNumber(-8, 8), 0, rng:NextNumber(-4, 4)))
	end
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	humanoid.Died:Connect(function()
		if active[player] then
			leaveRound(player)
			notify(player, "The Balrog claims you... you'll rise again next round.", "lose")
		end
	end)
end

local function onPlayerAdded(player: Player)
	player:SetAttribute("InRound", false)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	onPlayerAdded(player)
end

Players.PlayerRemoving:Connect(function(player)
	active[player] = nil
end)

--------------------------------------------------------------------------------
-- Hazards and pickups

local function spawnEmber(current: ShaftBuilder.Shaft)
	local targets = {}
	for player in active do
		local root = rootOf(player)
		if root then
			table.insert(targets, root)
		end
	end
	if #targets == 0 then
		return
	end

	-- Drop it from above a random climber so it is always a threat to someone.
	local target = targets[rng:NextInteger(1, #targets)]
	local flat = Vector2.new(target.Position.X + rng:NextNumber(-14, 14), target.Position.Z + rng:NextNumber(-14, 14))
	local limit = Config.ShaftRadius - 2
	if flat.Magnitude > limit then
		flat = flat.Unit * limit
	end

	local ember = Instance.new("Part")
	ember.Name = "Ember"
	ember.Shape = Enum.PartType.Ball
	ember.Size = Vector3.one * rng:NextNumber(1.5, 2.6)
	ember.Material = Enum.Material.Neon
	ember.Color = Color3.fromRGB(255, rng:NextInteger(90, 150), 30)
	ember.CanCollide = false
	ember.CastShadow = false
	ember.Position = Vector3.new(flat.X, target.Position.Y + rng:NextNumber(45, 60), flat.Y)
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 0
	fire.Parent = ember
	ember.Parent = current.Embers
	ember:SetNetworkOwner(nil)
	ember.AssemblyLinearVelocity = Vector3.new(0, -25, 0)

	local spent = false
	ember.Touched:Connect(function(hit)
		local player = if spent then nil else playerFromHit(hit)
		if not player or not active[player] then
			return
		end
		local humanoid = ((player :: Player).Character :: Model):FindFirstChildOfClass("Humanoid")
		if humanoid then
			spent = true
			humanoid:TakeDamage(Config.EmberDamage)
			ember:Destroy()
		end
	end)
	Debris:AddItem(ember, 6)
end

local function hookPickups(current: ShaftBuilder.Shaft)
	for _, rune in current.Runes do
		rune.Touched:Connect(function(hit)
			local player = if rune.Parent then playerFromHit(hit) else nil
			if player and active[player] then
				rune:Destroy()
				DataService.addRunes(player, 1)
				notify(player, "+1 rune", "rune")
			end
		end)
	end

	current.Goal.Touched:Connect(function(hit)
		local hitPlayer = playerFromHit(hit)
		if not hitPlayer or not active[hitPlayer] then
			return
		end
		local player = hitPlayer :: Player
		leaveRound(player)
		DataService.addWin(player)
		DataService.addRunes(player, Config.EscapeReward)
		notify(player, ("You escaped the Balrog! +%d runes"):format(Config.EscapeReward), "win")
		for _, other in Players:GetPlayers() do
			if other ~= player then
				notify(other, player.DisplayName .. " escaped the Balrog!", "info")
			end
		end
		task.delay(2, function()
			if not player:GetAttribute("InRound") then
				sendToLobby(player)
			end
		end)
	end)
end

CastWard.OnServerEvent:Connect(function(player)
	local now = workspace:GetServerTimeNow()
	local readyAt = (player:GetAttribute("WardReadyAt") :: number?) or 0
	local maybeRoot = rootOf(player)
	if now < readyAt or not maybeRoot then
		return
	end
	local root = maybeRoot :: BasePart
	player:SetAttribute("WardReadyAt", now + Config.WardCooldown)

	local current = shaft
	if current then
		for _, ember in current.Embers:GetChildren() do
			if ember:IsA("BasePart") and (ember.Position - root.Position).Magnitude <= Config.WardRadius then
				ember:Destroy()
			end
		end
	end

	local burst = Instance.new("Part")
	burst.Name = "Ward"
	burst.Shape = Enum.PartType.Ball
	burst.Anchored = true
	burst.CanCollide = false
	burst.CanTouch = false
	burst.CanQuery = false
	burst.CastShadow = false
	burst.Material = Enum.Material.ForceField
	burst.Color = Color3.fromRGB(140, 210, 255)
	burst.Size = Vector3.one * 2
	burst.Position = root.Position
	burst.Parent = workspace
	TweenService:Create(burst, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.one * Config.WardRadius * 2,
		Transparency = 1,
	}):Play()
	Debris:AddItem(burst, 0.6)
end)

--------------------------------------------------------------------------------
-- Round loop

local function countActive(): number
	local count = 0
	for _ in active do
		count += 1
	end
	return count
end

local function runRound()
	local current = ShaftBuilder.build()
	shaft = current
	lavaTop = Config.LavaStartY
	State:SetAttribute("LavaTop", lavaTop)
	State:SetAttribute("GoalY", current.GoalY)
	hookPickups(current)

	table.clear(active)
	local slot = 0
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character and rootOf(player) then
			slot += 1
			active[player] = true
			player:SetAttribute("InRound", true)
			player:SetAttribute("WardReadyAt", 0)
			character:PivotTo(current.SpawnPoints[(slot - 1) % #current.SpawnPoints + 1])
		end
	end
	State:SetAttribute("InRound", true)
	notify(nil, "The Balrog wakes. CLIMB!", "warn")

	local elapsed = 0
	local emberClock = 0
	local publishClock = 0
	local heartbeat = RunService.Heartbeat:Connect(function(dt)
		elapsed += dt

		if elapsed > Config.LavaDelaySeconds then
			local t = elapsed - Config.LavaDelaySeconds
			lavaTop += (Config.LavaBaseSpeed + Config.LavaSpeedGain * t) * dt
			ShaftBuilder.setLavaTop(current, lavaTop)
		end

		publishClock += dt
		if publishClock >= 0.1 then
			publishClock = 0
			State:SetAttribute("LavaTop", lavaTop)
		end

		-- Embers fall faster as the round goes on.
		emberClock += dt
		if emberClock >= Config.EmberInterval / (1 + elapsed / 60) then
			emberClock = 0
			spawnEmber(current)
		end

		-- Anyone whose feet sink below the lava is done.
		for player in active do
			local root = rootOf(player)
			if root and root.Position.Y - 2.5 < lavaTop then
				local humanoid = (player.Character :: Model):FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid.Health = 0
				end
			end
		end
	end)

	while elapsed < Config.RoundSeconds and countActive() > 0 do
		setStatus(("Escape the Balrog! %d climbing"):format(countActive()), math.ceil(Config.RoundSeconds - elapsed))
		task.wait(0.25)
	end
	heartbeat:Disconnect()

	-- Whoever is still climbing when time runs out is swallowed by the dark.
	for player in active do
		notify(player, "Time's up! The shadow swallows the shaft.", "lose")
		leaveRound(player)
		sendToLobby(player)
	end
	State:SetAttribute("InRound", false)

	for t = Config.PostRoundSeconds, 1, -1 do
		setStatus("Round over", t)
		task.wait(1)
	end
	current.Folder:Destroy()
	shaft = nil
end

while true do
	while #Players:GetPlayers() < Config.MinPlayers do
		setStatus(("Waiting for players (%d/%d)"):format(#Players:GetPlayers(), Config.MinPlayers), 0)
		task.wait(1)
	end
	for t = Config.IntermissionSeconds, 1, -1 do
		setStatus("Next climb starts in", t)
		task.wait(1)
	end
	runRound()
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">ShaftBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds a fresh shaft each round: walls, a random climb of platforms, runes,
-- the escape gate at the top, the lava and the Balrog riding up on it.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local LAVA_THICKNESS = 40

export type Shaft = {
	Folder: Folder,
	Embers: Folder,
	Lava: Part,
	Balrog: Model,
	BalrogBase: CFrame,
	Goal: Part,
	GoalY: number,
	Runes: { Part },
	SpawnPoints: { CFrame },
}

local ShaftBuilder = {}

local function part(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	p.Parent = parent
	return p
end

-- Decoration that nothing should touch, hit or ray-cast against.
local function ghost(p: Part): Part
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	return p
end

-- Crumbling platforms flash when stepped on, drop away, then come back.
local function makeCrumbling(p: Part)
	local busy = false
	local color = p.Color
	p.Touched:Connect(function(hit)
		if busy then
			return
		end
		local model = hit:FindFirstAncestorOfClass("Model")
		if not (model and model:FindFirstChildOfClass("Humanoid")) then
			return
		end
		busy = true
		p.Color = Color3.fromRGB(255, 120, 40)
		task.wait(0.7)
		if not p.Parent then
			return
		end
		p.Transparency = 0.85
		p.CanCollide = false
		task.wait(3)
		if not p.Parent then
			return
		end
		p.Transparency = 0
		p.CanCollide = true
		p.Color = color
		busy = false
	end)
end

local function buildWalls(folder: Folder, origin: Vector3)
	local segments = 28
	local radius = Config.ShaftRadius + 3
	local bottom = -30
	local height = Config.ShaftHeight + 90
	local width = 2 * math.pi * radius / segments + 1
	local rock = Color3.fromRGB(48, 40, 38)

	for i = 1, segments do
		local angle = (i / segments) * 2 * math.pi
		local position = origin + Vector3.new(math.cos(angle) * radius, bottom + height / 2, math.sin(angle) * radius)
		local center = Vector3.new(origin.X, position.Y, origin.Z)
		part(folder, {
			Name = "Wall",
			Size = Vector3.new(width, height, 4),
			CFrame = CFrame.lookAt(position, center),
			Material = Enum.Material.Basalt,
			Color = rock,
		})

		-- Torches climb the walls so the shaft is never fully dark.
		if i % 7 == 0 then
			for y = 30, Config.ShaftHeight, 60 do
				local torchPos = origin
					+ Vector3.new(math.cos(angle) * (radius - 2.5), y + (i % 2) * 30, math.sin(angle) * (radius - 2.5))
				local flame = ghost(part(folder, {
					Name = "Torch",
					Size = Vector3.new(1, 1.4, 1),
					Position = torchPos,
					Material = Enum.Material.Neon,
					Color = Color3.fromRGB(255, 140, 40),
				}))
				local light = Instance.new("PointLight")
				light.Color = Color3.fromRGB(255, 150, 70)
				light.Range = 30
				light.Brightness = 1.6
				light.Parent = flame
			end
		end
	end

	local floorSize = 2 * radius + 8
	part(folder, {
		Name = "Floor",
		Size = Vector3.new(floorSize, 2, floorSize),
		Position = origin + Vector3.new(0, -1, 0),
		Material = Enum.Material.Basalt,
		Color = Color3.fromRGB(40, 34, 32),
	})

	-- Daylight far above: the way out.
	local sky = ghost(part(folder, {
		Name = "Daylight",
		Size = Vector3.new(2 * radius, 1, 2 * radius),
		Position = origin + Vector3.new(0, Config.ShaftHeight + 58, 0),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 244, 214),
	}))
	local sun = Instance.new("SurfaceLight")
	sun.Face = Enum.NormalId.Bottom
	sun.Range = 60
	sun.Angle = 120
	sun.Brightness = 3
	sun.Color = Color3.fromRGB(255, 240, 210)
	sun.Parent = sky
end

-- Random walk upward. Each hop is always jumpable, but hops get longer,
-- platforms get smaller and more of them crumble the higher you go.
local function buildPlatforms(folder: Folder, origin: Vector3, rng: Random): ({ Part }, Part)
	local platforms: { Part } = {}
	local x, z, y = 0, 0, 0
	local lastSize = 14
	local limit = Config.ShaftRadius - 8

	local function nextSpot(size: number, progress: number): (number, number)
		local gap = rng:NextNumber(1, 2 + 2 * progress)
		local distance = (lastSize + size) / 2 + gap
		local angle = rng:NextNumber(0, 2 * math.pi)
		local nx, nz = x + math.cos(angle) * distance, z + math.sin(angle) * distance
		if Vector2.new(nx, nz).Magnitude > limit then
			-- Turn back toward the middle of the shaft.
			angle = math.atan2(-z, -x) + rng:NextNumber(-0.7, 0.7)
			nx, nz = x + math.cos(angle) * distance, z + math.sin(angle) * distance
		end
		return nx, nz
	end

	-- Stop a short hop below the top so the last jump onto the gate is easy too.
	while Config.ShaftHeight - y > 4.5 do
		local progress = y / Config.ShaftHeight
		y += math.min(rng:NextNumber(3, 3.5 + 1.2 * progress), Config.ShaftHeight - y - 2.5)
		local size = math.max(5, 10 - 4 * progress + rng:NextNumber(-1, 1))
		x, z = nextSpot(size, progress)
		lastSize = size

		local crumbles = progress > 0.25 and rng:NextNumber() < 0.1 + 0.3 * progress
		local hue = rng:NextNumber(-8, 8)
		local p = part(folder, {
			Name = if crumbles then "Crumbling" else "Ledge",
			Size = Vector3.new(size, 1.2, size * rng:NextNumber(0.75, 1)),
			CFrame = CFrame.new(origin + Vector3.new(x, y, z)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
			Material = if crumbles then Enum.Material.CrackedLava else Enum.Material.Slate,
			Color = if crumbles
				then Color3.fromRGB(120, 70, 50)
				else Color3.fromRGB(100 + hue, 94 + hue, 90 + hue),
		})
		if crumbles then
			makeCrumbling(p)
		end
		table.insert(platforms, p)
	end

	-- The escape gate: a wide golden ledge at the very top.
	y = Config.ShaftHeight
	x, z = nextSpot(16, 1)
	local goal = part(folder, {
		Name = "EscapeGate",
		Size = Vector3.new(16, 1.2, 16),
		Position = origin + Vector3.new(x, y, z),
		Material = Enum.Material.Foil,
		Color = Color3.fromRGB(240, 196, 90),
	})
	local ring = ghost(part(folder, {
		Name = "GateRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 14, 14),
		CFrame = CFrame.new(goal.Position + Vector3.new(0, 7.6, 0)),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 225, 140),
		Transparency = 0.3,
	}))
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 225, 150)
	glow.Range = 40
	glow.Brightness = 3
	glow.Parent = ring

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(220, 60)
	billboard.StudsOffset = Vector3.new(0, 16, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 200
	billboard.Parent = goal
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Fantasy
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 225, 140)
	label.TextStrokeTransparency = 0.4
	label.Text = "ESCAPE"
	label.Parent = billboard

	return platforms, goal
end

local function buildRunes(folder: Folder, platforms: { Part }, rng: Random): { Part }
	local candidates = {}
	for i = 3, #platforms do
		table.insert(candidates, platforms[i])
	end
	local runes: { Part } = {}
	for _ = 1, math.min(Config.RuneCount, #candidates) do
		local platform = table.remove(candidates, rng:NextInteger(1, #candidates)) :: Part
		local rune = part(folder, {
			Name = "Rune",
			Size = Vector3.new(1.4, 1.4, 0.4),
			CFrame = CFrame.new(platform.Position + Vector3.new(0, 3, 0))
				* CFrame.Angles(0, rng:NextNumber(0, math.pi), math.rad(45)),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(120, 220, 255),
			CanCollide = false,
		})
		local light = Instance.new("PointLight")
		light.Color = rune.Color
		light.Range = 8
		light.Parent = rune
		table.insert(runes, rune)
	end
	return runes
end

local function buildBalrog(folder: Folder, base: CFrame): Model
	local model = Instance.new("Model")
	model.Name = "Balrog"

	local shadow = Color3.fromRGB(30, 18, 16)
	local function piece(name: string, size: Vector3, offset: CFrame, props: { [string]: any }?): Part
		local p = ghost(part(model, {
			Name = name,
			Size = size,
			CFrame = base * offset,
			Material = Enum.Material.Slate,
			Color = shadow,
		}))
		if props then
			for key, value in props do
				(p :: any)[key] = value
			end
		end
		return p
	end

	local body = piece("Body", Vector3.new(16, 26, 9), CFrame.new())
	piece("Head", Vector3.new(8, 8, 8), CFrame.new(0, 17, 0))
	for _, side in { -1, 1 } do
		piece("Eye", Vector3.new(1.6, 0.9, 0.4), CFrame.new(side * 1.8, 18, -4.1), {
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 220, 60),
		})
		piece("Horn", Vector3.new(1.4, 7, 1.4), CFrame.new(side * 4.4, 23, 0) * CFrame.Angles(0, 0, math.rad(-side * 25)))
		piece("Wing", Vector3.new(1.5, 20, 26), CFrame.new(side * 10, 8, 6) * CFrame.Angles(math.rad(20), 0, math.rad(side * 30)), {
			Transparency = 0.15,
		})
		piece("Arm", Vector3.new(4, 18, 4), CFrame.new(side * 10, 2, -2) * CFrame.Angles(math.rad(-30), 0, 0))
	end

	local fire = Instance.new("Fire")
	fire.Size = 14
	fire.Heat = 12
	fire.Color = Color3.fromRGB(255, 110, 30)
	fire.SecondaryColor = Color3.fromRGB(255, 200, 60)
	fire.Parent = body

	model.PrimaryPart = body
	model.Parent = folder
	return model
end

function ShaftBuilder.build(): Shaft
	local origin = Config.ShaftOrigin
	local rng = Random.new()

	local folder = Instance.new("Folder")
	folder.Name = "Shaft"

	buildWalls(folder, origin)
	local platforms, goal = buildPlatforms(folder, origin, rng)
	local runes = buildRunes(folder, platforms, rng)

	local lavaSize = 2 * Config.ShaftRadius + 10
	local lava = ghost(part(folder, {
		Name = "Lava",
		Size = Vector3.new(lavaSize, LAVA_THICKNESS, lavaSize),
		Material = Enum.Material.CrackedLava,
		Color = Color3.fromRGB(255, 90, 20),
	}))
	local top = Instance.new("Attachment")
	top.Position = Vector3.new(0, LAVA_THICKNESS / 2 + 2, 0)
	top.Parent = lava
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 110, 40)
	glow.Range = 60
	glow.Brightness = 4
	glow.Parent = top

	-- The Balrog stands against the far wall, facing the climbers.
	local balrogSpot = Vector3.new(origin.X, -2, origin.Z - (Config.ShaftRadius - 7))
	local balrogBase = CFrame.lookAt(balrogSpot, Vector3.new(origin.X, -2, origin.Z))
	local balrog = buildBalrog(folder, balrogBase)

	local embers = Instance.new("Folder")
	embers.Name = "Embers"
	embers.Parent = folder

	local spawnPoints = {}
	for i = 1, 12 do
		local angle = (i / 12) * 2 * math.pi
		local position = origin + Vector3.new(math.cos(angle) * 10, 4, math.sin(angle) * 10)
		table.insert(spawnPoints, CFrame.lookAt(position, Vector3.new(origin.X, position.Y, origin.Z)))
	end

	folder.Parent = workspace

	local shaft: Shaft = {
		Folder = folder,
		Embers = embers,
		Lava = lava,
		Balrog = balrog,
		BalrogBase = balrogBase,
		Goal = goal,
		GoalY = origin.Y + Config.ShaftHeight,
		Runes = runes,
		SpawnPoints = spawnPoints,
	}
	ShaftBuilder.setLavaTop(shaft, Config.LavaStartY)
	return shaft
end

function ShaftBuilder.setLavaTop(shaft: Shaft, y: number)
	local origin = Config.ShaftOrigin
	shaft.Lava.CFrame = CFrame.new(origin.X, y - LAVA_THICKNESS / 2, origin.Z)
	shaft.Balrog:PivotTo(shaft.BalrogBase + Vector3.new(0, y, 0))
end

return ShaftBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the things that last the whole server: lighting and the lobby.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local World = {}

local function part(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	p.Parent = parent
	return p
end

local function torch(parent: Instance, position: Vector3)
	local flame = part(parent, {
		Name = "Torch",
		Size = Vector3.new(1, 1, 1),
		Position = position,
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 140, 40),
		CanCollide = false,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 70)
	light.Range = 22
	light.Brightness = 2
	light.Parent = flame
	local fire = Instance.new("Fire")
	fire.Size = 2
	fire.Heat = 4
	fire.Parent = flame
end

local function setUpLighting()
	Lighting.ClockTime = 0
	Lighting.Brightness = 1
	Lighting.Ambient = Color3.fromRGB(45, 30, 30)
	Lighting.OutdoorAmbient = Color3.fromRGB(60, 40, 40)
	Lighting.EnvironmentDiffuseScale = 0.2
	Lighting.EnvironmentSpecularScale = 0.2

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.35
	atmosphere.Color = Color3.fromRGB(120, 60, 40)
	atmosphere.Decay = Color3.fromRGB(60, 20, 10)
	atmosphere.Glare = 0
	atmosphere.Haze = 2
	atmosphere.Parent = Lighting

	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.8
	bloom.Size = 30
	bloom.Threshold = 0.9
	bloom.Parent = Lighting
end

-- Returns the CFrame where players should stand when sent back to the lobby.
function World.build(): CFrame
	setUpLighting()

	local folder = Instance.new("Folder")
	folder.Name = "Lobby"
	folder.Parent = workspace

	local origin = Config.LobbyOrigin
	local stone = Color3.fromRGB(70, 66, 64)

	part(folder, {
		Name = "Floor",
		Size = Vector3.new(70, 2, 70),
		Position = origin + Vector3.new(0, -1, 0),
		Material = Enum.Material.Slate,
		Color = stone,
	})

	-- Low walls so nobody wanders off the edge.
	for _, side in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) } do
		local size = if side.X ~= 0 then Vector3.new(2, 6, 70) else Vector3.new(70, 6, 2)
		part(folder, {
			Name = "Wall",
			Size = size,
			Position = origin + side * 34 + Vector3.new(0, 3, 0),
			Material = Enum.Material.Cobblestone,
			Color = stone,
		})
	end

	for _, corner in { Vector3.new(1, 0, 1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, -1) } do
		local base = origin + corner * 28
		part(folder, {
			Name = "Pillar",
			Size = Vector3.new(4, 16, 4),
			Position = base + Vector3.new(0, 8, 0),
			Material = Enum.Material.Cobblestone,
			Color = Color3.fromRGB(55, 52, 50),
		})
		torch(folder, base + Vector3.new(0, 16.5, 0))
	end

	-- A big sign facing the spawn.
	local sign = part(folder, {
		Name = "Sign",
		Size = Vector3.new(40, 14, 2),
		Position = origin + Vector3.new(0, 12, -32),
		Material = Enum.Material.Basalt,
		Color = Color3.fromRGB(35, 28, 26),
	})
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Back
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 25
	surface.LightInfluence = 0
	surface.Parent = sign
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.6)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.Fantasy
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 170, 70)
	title.Text = "FLEE THE BALROG"
	title.Parent = surface
	local subtitle = title:Clone()
	subtitle.Position = UDim2.fromScale(0, 0.6)
	subtitle.Size = UDim2.fromScale(1, 0.3)
	subtitle.Font = Enum.Font.Gotham
	subtitle.TextColor3 = Color3.fromRGB(230, 220, 210)
	subtitle.Text = "Climb out of the deep before the fire reaches you"
	subtitle.Parent = surface

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = origin + Vector3.new(0, 0.5, 0)
	spawn.Material = Enum.Material.Marble
	spawn.Color = Color3.fromRGB(200, 190, 175)
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = folder

	return CFrame.new(origin + Vector3.new(0, 4, 6))
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="13">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterJumpHeight">7.2</float>
      <bool name="CharacterUseJumpPower">false</bool>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="14">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="16">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- On-screen HUD: round status, a climb meter showing you vs. the lava,
-- a red glow when the fire is close, pop-up messages and the Ward button.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Notify = Remotes:WaitForChild("Notify") :: RemoteEvent
local CastWard = Remotes:WaitForChild("CastWard") :: RemoteEvent
local State = ReplicatedStorage:WaitForChild("GameState")

local player = Players.LocalPlayer

local FIRE = Color3.fromRGB(255, 140, 50)
local PARCHMENT = Color3.fromRGB(240, 228, 210)
local PANEL = Color3.fromRGB(20, 14, 12)

local function make(className: string, props: { [string]: any }, children: { any }?): any
	local instance = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

local function corner(radius: number): UICorner
	return make("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local gui = make("ScreenGui", {
	Name = "BalrogHud",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

-- Red glow around the screen edges when the lava is close.
local danger = make("Frame", {
	Name = "Danger",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.fromRGB(255, 60, 20),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Parent = gui,
}, {
	make("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.25, 1),
			NumberSequenceKeypoint.new(0.75, 1),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Rotation = 90,
	}),
})

local statusPanel = make("Frame", {
	Name = "Status",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 52),
	Size = UDim2.fromOffset(360, 54),
	BackgroundColor3 = PANEL,
	BackgroundTransparency = 0.25,
	Parent = gui,
}, { corner(10), make("UIStroke", { Color = FIRE, Transparency = 0.4, Thickness = 1.5 }) })

local statusLabel = make("TextLabel", {
	Position = UDim2.fromOffset(14, 0),
	Size = UDim2.new(1, -90, 1, 0),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamMedium,
	TextSize = 18,
	TextColor3 = PARCHMENT,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextTruncate = Enum.TextTruncate.AtEnd,
	Text = "",
	Parent = statusPanel,
})

local timerLabel = make("TextLabel", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -14, 0, 0),
	Size = UDim2.new(0, 70, 1, 0),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	TextSize = 26,
	TextColor3 = FIRE,
	TextXAlignment = Enum.TextXAlignment.Right,
	Text = "",
	Parent = statusPanel,
})

-- Climb meter on the right edge: the bar is the shaft, the gold dot is you.
local meter = make("Frame", {
	Name = "ClimbMeter",
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -24, 0.5, 0),
	Size = UDim2.fromOffset(16, 300),
	BackgroundColor3 = PANEL,
	BackgroundTransparency = 0.2,
	Visible = false,
	Parent = gui,
}, { corner(8) })

local lavaFill = make("Frame", {
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.fromScale(0, 1),
	Size = UDim2.fromScale(1, 0),
	BackgroundColor3 = Color3.fromRGB(255, 90, 20),
	BorderSizePixel = 0,
	Parent = meter,
}, { corner(8) })

local youDot = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 1),
	Size = UDim2.fromOffset(24, 24),
	BackgroundColor3 = Color3.fromRGB(255, 220, 120),
	ZIndex = 2,
	Parent = meter,
}, { corner(12), make("UIStroke", { Color = PANEL, Thickness = 2 }) })

make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 0, -6),
	Size = UDim2.fromOffset(80, 20),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	TextSize = 14,
	TextColor3 = Color3.fromRGB(255, 225, 140),
	Text = "ESCAPE",
	Parent = meter,
})

local depthLabel = make("TextLabel", {
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -52, 0.5, 0),
	Size = UDim2.fromOffset(160, 44),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamMedium,
	TextSize = 15,
	TextColor3 = PARCHMENT,
	TextXAlignment = Enum.TextXAlignment.Right,
	TextStrokeTransparency = 0.5,
	RichText = true,
	Visible = false,
	Text = "",
	Parent = gui,
})

local wardLabel = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -24),
	Size = UDim2.fromOffset(200, 32),
	BackgroundColor3 = PANEL,
	BackgroundTransparency = 0.3,
	Font = Enum.Font.GothamMedium,
	TextSize = 16,
	TextColor3 = Color3.fromRGB(150, 215, 255),
	Visible = false,
	Text = "",
	Parent = gui,
}, { corner(8) })

local toast = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.3),
	Size = UDim2.fromOffset(600, 50),
	BackgroundTransparency = 1,
	Font = Enum.Font.Fantasy,
	TextSize = 34,
	TextColor3 = PARCHMENT,
	TextStrokeTransparency = 0.3,
	TextTransparency = 1,
	TextStrokeColor3 = PANEL,
	TextWrapped = true,
	Text = "",
	Parent = gui,
})

local runePop = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.62),
	Size = UDim2.fromOffset(200, 30),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	TextSize = 24,
	TextColor3 = Color3.fromRGB(120, 220, 255),
	TextStrokeTransparency = 0.4,
	TextTransparency = 1,
	Text = "",
	Parent = gui,
})

local pickupSound = make("Sound", {
	SoundId = "rbxasset://sounds/electronicpingshort.wav",
	Volume = 0.5,
	Parent = SoundService,
})

local TOAST_COLORS = {
	warn = FIRE,
	lose = Color3.fromRGB(255, 110, 90),
	win = Color3.fromRGB(255, 225, 140),
	info = PARCHMENT,
}

local toastTween: Tween? = nil
local function showToast(text: string, color: Color3)
	if toastTween then
		toastTween:Cancel()
	end
	toast.Text = text
	toast.TextColor3 = color
	toast.TextTransparency = 0
	toast.TextStrokeTransparency = 0.3
	toastTween = TweenService:Create(toast, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 2.5), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})
	;(toastTween :: Tween):Play()
end

local runeStreak = 0
local runeTween: Tween? = nil
local function showRune(text: string)
	runeStreak += 1
	runePop.Text = if runeStreak > 1 then ("%s  x%d"):format(text, runeStreak) else text
	runePop.TextTransparency = 0
	runePop.TextStrokeTransparency = 0.4
	if runeTween then
		runeTween:Cancel()
	end
	local tween = TweenService:Create(runePop, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.8), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})
	tween.Completed:Connect(function(playbackState)
		if playbackState == Enum.PlaybackState.Completed then
			runeStreak = 0
		end
	end)
	tween:Play()
	runeTween = tween
	pickupSound:Play()
end

Notify.OnClientEvent:Connect(function(text: string, kind: string)
	if kind == "rune" then
		showRune(text)
	else
		showToast(text, TOAST_COLORS[kind] or PARCHMENT)
	end
end)

ContextActionService:BindAction("CastWard", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		CastWard:FireServer()
	end
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
ContextActionService:SetTitle("CastWard", "Ward")

RunService.RenderStepped:Connect(function()
	local timeLeft = (State:GetAttribute("TimeLeft") :: number?) or 0
	statusLabel.Text = (State:GetAttribute("Status") :: string?) or ""
	timerLabel.Text = if timeLeft > 0 then ("%d:%02d"):format(timeLeft // 60, timeLeft % 60) else ""

	local inRound = player:GetAttribute("InRound") == true
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	meter.Visible = inRound and root ~= nil
	depthLabel.Visible = meter.Visible
	wardLabel.Visible = meter.Visible

	if not inRound or not root then
		danger.BackgroundTransparency = 1
		return
	end

	local floorY = Config.ShaftOrigin.Y
	local goalY = (State:GetAttribute("GoalY") :: number?) or (floorY + Config.ShaftHeight)
	local lavaTop = (State:GetAttribute("LavaTop") :: number?) or Config.LavaStartY
	local span = goalY - floorY
	local feet = root.Position.Y - 3

	youDot.Position = UDim2.fromScale(0.5, 1 - math.clamp((feet - floorY) / span, 0, 1))
	lavaFill.Size = UDim2.fromScale(1, math.clamp((lavaTop - floorY) / span, 0, 1))

	local toGo = math.max(0, goalY - feet) / Config.StudsPerFathom
	local gap = (feet - lavaTop) / Config.StudsPerFathom
	depthLabel.Text = ("%d fathoms to go\n<font color=\"#ff8a3c\">fire %d below</font>"):format(math.floor(toGo), math.floor(math.max(gap, 0)))

	-- Glow brightens from 15 fathoms away down to nothing.
	danger.BackgroundTransparency = math.clamp(gap / 15, 0.15, 1)

	local readyAt = (player:GetAttribute("WardReadyAt") :: number?) or 0
	local remaining = readyAt - workspace:GetServerTimeNow()
	wardLabel.Text = if remaining > 0 then ("Ward in %ds"):format(math.ceil(remaining)) else "Ward ready  [E]"
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>